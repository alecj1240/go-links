{
  "manifest_version": 3,
  "name": "Go Links",
  "version": "1.0.0",
  "description": "Create and manage custom go links in Chrome.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://go/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
